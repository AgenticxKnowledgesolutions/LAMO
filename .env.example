# ============================================================
# LAMO - Environment configuration
# ------------------------------------------------------------
# 1. Copy this file to `.env` inside the folder that contains
#    manage.py  (i.e. lamo/.env)
# 2. Fill in real values. `.env` is git-ignored - never commit it.
# ============================================================

# ------------------------------------------------------------
# Django core
# ------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# REQUIRED when DJANGO_ENV=production. The app signs sessions, CSRF tokens
# and password-reset tokens with this key, so it must be long, random and
# unique to this deployment. settings.py refuses to start a production
# process if this is missing, still set to the committed development key, or
# shorter than 50 characters. Leave it unset ONLY while developing locally.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Never leave this True on a public server
DJANGO_DEBUG=True

# Comma separated, no spaces
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# development | production
# 'production' turns on HTTPS/HSTS/secure-cookie hardening in settings.py and
# makes DJANGO_SECRET_KEY and DJANGO_CACHE_URL mandatory (the process refuses
# to start otherwise, rather than degrading to insecure defaults).
# In production DJANGO_DEBUG must also be absent/False: settings.py raises
# ImproperlyConfigured if DEBUG is enabled together with DJANGO_ENV=production.
DJANGO_ENV=development

# Display timezone. Existing data is stored in UTC so leaving this as UTC
# keeps today's behaviour; use Asia/Kolkata for Indian local time.
DJANGO_TIME_ZONE=UTC

# Required when DJANGO_ENV=production behind a proxy (comma separated)
DJANGO_CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Option A (recommended, especially for production): a single connection
# string. Accepted schemes: mysql:// mariadb:// postgresql:// sqlite:///
#   DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Special characters in USER/PASSWORD must be URL-encoded (@ -> %40).
# When DATABASE_URL is set, the DJANGO_DB_* values below are ignored.
#DATABASE_URL=mysql://lamo_user:change-me@127.0.0.1:3306/lamo_project

# Option B: individual values. These defaults match the original local MySQL
# setup. Keep these settings aligned with the database containing your users.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=lamo_project
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
# Persistent DB connections, in seconds. 0 disables them (the default).
DJANGO_DB_CONN_MAX_AGE=0

# --- TLS/SSL for a hosted MySQL (e.g. Aiven) -------------------------
# OPTIONAL. Both default to empty, and with no SSL variables the local
# MySQL connection behaves exactly as it always has.
#
# Set DJANGO_DB_SSL_CA to the ABSOLUTE path of the CA certificate
# (Aiven: service Overview -> Connection information -> CA Certificate -> Download)
# to require an encrypted connection that verifies the server certificate.
#
# DJANGO_DB_SSL_MODE controls how strictly the server is verified:
#   VERIFY_IDENTITY  verify CA chain AND hostname (default, recommended)
#   VERIFY_CA        verify CA chain only
# Any other value - including DISABLED, PREFERRED and REQUIRED - is rejected
# at startup: certificate verification cannot be switched off.
# A missing/unreadable DJANGO_DB_SSL_CA also fails fast rather than silently
# connecting without verification.
DJANGO_DB_SSL_MODE=
DJANGO_DB_SSL_CA=

# Never commit real production credentials - .env is git-ignored.

# ------------------------------------------------------------
# Cache - REQUIRED in production
# ------------------------------------------------------------
# The server-side rate limits that protect login, forgot-password and
# OTP resend live in Django's cache. In development that is an in-process
# cache, which is fine for a single `runserver` process.
#
# In production it MUST be a SHARED cache. A per-process cache gives every
# gunicorn worker its own counters, so a "5 attempts then lockout" rule
# really allows 5 x (number of workers) attempts and the lockout can be
# sidestepped by spreading requests. settings.py raises
# ImproperlyConfigured and refuses to start if this is missing when
# DJANGO_ENV=production - it will not silently fall back.
#
# Redis (recommended):
#   DJANGO_CACHE_URL=redis://:password@host:6379/0
#   DJANGO_CACHE_URL=rediss://:password@host:6379/0    (TLS)
# Memcached (needs the optional pymemcache package):
#   DJANGO_CACHE_URL=memcached://host:11211
#
# Put the real password in your environment / secret store, never in git.
# Leave this EMPTY only for local development.
DJANGO_CACHE_URL=

# ------------------------------------------------------------
# Email - used for signup OTP, password reset and booking mails
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
# For local development you can avoid SMTP entirely with:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# ------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------
# AI (optional) - Google Gemini API key
# Leave blank to disable AI features; the app falls back to
# local database matching.
# ------------------------------------------------------------
GOOGLE_API_KEY=

# ------------------------------------------------------------
# Map tiles (Leaflet) - booking page + worker booking modal
# ------------------------------------------------------------
# Default is CARTO basemaps: free, no API key needed, but shows CARTO
# branding/watermark. To use a custom tile provider or remove the CARTO
# watermark, set MAP_TILE_URL and, if required, MAP_TILE_API_KEY.
#
# Examples:
#   CARTO with API key:
#     MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
#     MAP_TILE_API_KEY=your_carto_api_key
#
#   MapTiler:
#     MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png
#     MAP_TILE_API_KEY=your_maptiler_key
#
# Do NOT use https://{s}.tile.openstreetmap.org/... here: the public OSM tile
# server blocks application traffic with HTTP 403 "Access blocked - tile usage
# policy".
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_TILE_API_KEY=
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20

# ------------------------------------------------------------
# Media - user uploads (profile images, service images, worker proofs)
# ------------------------------------------------------------
# MEDIA_URL / MEDIA_ROOT default to /media/ and <project>/media, which is a
# local, NON-PERSISTENT directory on Render: uploads are lost on every
# deploy/restart. To persist them, mount a Render persistent disk and point
# DJANGO_MEDIA_ROOT at the mount path (no code change needed).
#
#   DJANGO_MEDIA_ROOT=/opt/render/project/src/lamo/media
#
# Private worker proof documents (media/worker_proofs/) are NEVER served from
# their public URL - urls.py blocks that path unconditionally - and are only
# downloadable by admins through the authenticated proof-download endpoint.
# Enabling DJANGO_SERVE_MEDIA therefore does NOT expose them.
#
# Serve /media/ through Django when DEBUG=False (interim option if you are not
# using a disk/CDN yet). Leave False if a proxy/CDN serves media for you.
DJANGO_SERVE_MEDIA=False

# Explicit media location (optional; defaults to <project>/media).
# DJANGO_MEDIA_ROOT=

# ------------------------------------------------------------

# Identifies LAMO to Nominatim (reverse/forward geocoding used by the maps).
# The OSM usage policy asks for a contact address - add one for production.
GEOCODING_USER_AGENT=LAMO/1.0
